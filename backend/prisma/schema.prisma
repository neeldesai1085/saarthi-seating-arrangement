generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model Room {
    id String @id @default(cuid())
    roomName String
    rows Int
    columns Int
    totalSeats Int
    sortOrder Int @default(0)
}

model Rule {
    id String @id @default(cuid())
    enforceAlternateSeating Boolean @default(true)
    fillRoomsCompletely Boolean @default(true)
}
